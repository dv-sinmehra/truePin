# TinyFish Live-Web OSINT API Key  (required for the TinyFish features)
# Get yours at: https://agent.tinyfish.ai/api-keys
# Used for real Search API + Fetch API + Web Agent calls. There is no mock fallback:
# without a valid key the TinyFish endpoints return a clear error.
# Check it works: GET /api/tinyfish/health
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Optional: seconds verify-osint waits for the Web Agent before returning its run_id
TINYFISH_AGENT_MAX_WAIT=75

# Google Gemini (ai_reasoner skill) — get a key at https://aistudio.google.com/app/apikey
# Without it, ai_reasoner returns rule-based answers labelled ai_powered=false.
# Check it works: GET /api/ai/health
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: pin a specific model instead of Google's "latest Flash" alias
# GEMINI_MODEL=gemini-flash-latest

# Optional: extra hostnames / browser origins allowed to call the MCP endpoint (/mcp).
# The Render hostname is added automatically.
# MCP_ALLOWED_HOSTS=my-custom-domain.com
# MCP_ALLOWED_ORIGINS=https://my-frontend.example.com
